# WSL stage. Copy to .env — do not commit.

DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=.racunai.hr,finestarerp,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.racunai.hr
TENANT_PLATFORM_DOMAIN=racunai.hr
TENANT_STAGE_INFIX=-stage
TENANT_PLATFORM_ADMIN_HOSTS=admin-stage.racunai.hr
TURNSTILE_ADMIN_HOSTS=admin-stage.racunai.hr
PLATFORM_ADMIN_LOGIN_URL=https://admin-stage.racunai.hr/admin/login/
SESSION_COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=True

DATABASE_HOST=postgis
DATABASE_PORT=5432
DATABASE_NAME=finestar_erp_stage_db
DATABASE_USER=racunai
DATABASE_PASSWORD=change-me

CELERY_BROKER_URL=redis://infra-redis:6379/5
CELERY_RESULT_BACKEND=redis://infra-redis:6379/5

RACUNAI_ADMIN_HOST=admin-stage.racunai.hr
RACUNAI_APP_HOST=app-stage.racunai.hr
RACUNAI_WWW_HOST=stage.racunai.hr
RACUNAI_WWW_ALIAS=www-stage.racunai.hr
RACUNAI_MPS_HOST=mps-stage.racunai.hr
RACUNAI_OTP_HOST=otp-sbx-stage.racunai.hr

NEXT_PUBLIC_APP_URL=https://app-stage.racunai.hr
NEXT_PUBLIC_DEMO_URL=https://demo-stage.racunai.hr
NEXT_PUBLIC_API_URL=https://admin-stage.racunai.hr
NEXT_PUBLIC_PLATFORM_DOMAIN=racunai.hr
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

OTP_SERVICE_HOST=otp-sbx-stage.racunai.hr
OTP_REDIRECT_URI=https://otp-sbx-stage.racunai.hr/oauth/callback/
TURNSTILE_VERIFY_ENABLED=False

MPS_SERVICE_URL=http://racunai_mps:8000

# Fiscal Gateway (intermediary). Host from the container is postgis, not 127.0.0.1.
GATEWAY_DATABASE_URL=postgresql+psycopg://racunai_intermediary:change-me@postgis:5432/racunai_intermediary
GATEWAY_JWT_SECRET=change-me
GATEWAY_JWT_ISS=racunai-api
GATEWAY_JWT_AUD=racunai-intermediary
# Transitional Super credential map. Not a secret store. Never commit real values.
# GATEWAY_SUPER_CREDENTIALS_JSON={"ref":{"base_url":"https://api.super.hr","username":"","password":"","company_guid":""}}
# GATEWAY_SUPER_LOOKUP_CREDENTIAL_REF=
# Human SUPER portal base for Documents integration.external_view_url (fail closed if unset).
# SUPER_PORTAL_BASE_URL=https://moj.super.hr
# Inbound eRačun sync writes Expense rows from live provider data — opt in per environment.
ERACUN_INBOUND_SYNC_ENABLED=False
# ERACUN_INBOUND_IMPORT_LIMIT=25
# Deploy-time only (provision_database.py). Not used by the app.
# POSTGRES_ADMIN_URL=postgresql://admin@127.0.0.1:5432/postgres
# GATEWAY_DB_PASSWORD=change-me

# Purchasing OCR (Purchasing AI)
# OPENAI_API_KEY=
# OPENAI_OCR_MODEL=gpt-4.1-mini
# PURCHASING_OCR_PROVIDER=openai
